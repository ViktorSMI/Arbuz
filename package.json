{
  "name": "arbuz-souls",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Standalone browser game with an optional WebSocket relay",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-local.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-sources.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:art": "node scripts/smoke-art.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "playwright": "^1.58.2"
  }
}
